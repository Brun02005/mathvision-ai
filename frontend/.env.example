# Copiá este archivo como frontend/.env (se leen al hacer build: reiniciá Vite si los cambiás).

# Supabase Auth. Sin estas dos, la app corre en modo local sin login (solo desarrollo).
# La "publishable key" (anon) es pública por diseño. NUNCA pongas acá la service_role key.
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Backend en otro dominio (por defecto, /api en el mismo dominio)
# VITE_API_URL=https://api.tudominio.com/api

# Datos legales que se muestran en Términos, Privacidad y Botón de arrepentimiento
# VITE_LEGAL_NAME=Mi Empresa S.R.L.
# VITE_LEGAL_TAX_ID=30-12345678-9
# VITE_LEGAL_ADDRESS=Calle 123, CABA, Argentina
# VITE_CONTACT_EMAIL=hola@tudominio.com
# Recién cuando un abogado revisó los textos: quita el aviso de "Borrador"
# VITE_LEGAL_REVIEWED=true
