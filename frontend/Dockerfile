FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Public values only (they end up in the JavaScript sent to every browser)
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_ANON_KEY=""
ARG VITE_LEGAL_NAME=""
ARG VITE_LEGAL_TAX_ID=""
ARG VITE_LEGAL_ADDRESS=""
ARG VITE_CONTACT_EMAIL=""
ARG VITE_LEGAL_REVIEWED=""
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_LEGAL_NAME=$VITE_LEGAL_NAME VITE_LEGAL_TAX_ID=$VITE_LEGAL_TAX_ID VITE_LEGAL_ADDRESS=$VITE_LEGAL_ADDRESS \
    VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL VITE_LEGAL_REVIEWED=$VITE_LEGAL_REVIEWED
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
