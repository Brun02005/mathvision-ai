# Copiá este archivo como backend/.env y completá los valores.

# development: modo local (sin login, un único usuario). Sin esta línea, o con cualquier
# otro valor, la app se comporta como producción y no arranca si falta configuración.
ENV=development

# Clave de Google AI Studio: https://aistudio.google.com/apikey
# Activa el OCR de fotos y el asistente de IA para enunciados y ejercicios que el motor exacto no entiende
GEMINI_API_KEY=
# Modelo de Gemini (por defecto el alias que apunta al Flash vigente)
# GEMINI_MODEL=gemini-flash-latest

# Base de datos (por defecto SQLite en backend/mathvision.db)
# DATABASE_URL=sqlite:///./mathvision.db

# Carpeta donde se guardan las imágenes subidas y tamaño máximo
# UPLOAD_DIR=./temp
# MAX_UPLOAD_MB=10

# Orígenes permitidos para CORS en producción, separados por coma
# CORS_ORIGINS=https://mathvision.tudominio.com

# Cálculo simbólico en procesos aparte con límite de tiempo
# SOLVER_WORKERS=2            # ejercicios resueltos en paralelo (0 = sin aislamiento ni límite, solo para depurar)
# SOLVE_TIMEOUT_SECONDS=20    # tiempo máximo por ejercicio
# SOLVER_QUEUE_TIMEOUT=15     # espera máxima por un worker libre antes de responder 503

# ── Producción ───────────────────────────────────────────────────────────────
# En producción borrá la línea ENV=development de arriba (o poné ENV=production):
# el servidor NO arranca si falta algo crítico (Supabase, Postgres, CORS, secreto del webhook).
# Clave secreta (solo backend, OBLIGATORIA en producción) para que "eliminar mi cuenta" borre también
# el login de Supabase (Project Settings > API Keys > service_role / secret):
# SUPABASE_SERVICE_ROLE_KEY=

# ── Cuentas (Supabase Auth) ──────────────────────────────────────────────────
# Sin esto, la app funciona en modo local con un único usuario (solo desarrollo).
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# En producción, la base es el Postgres de Supabase (Connect > Session pooler):
# DATABASE_URL=postgresql+psycopg://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Planes y límites diarios ─────────────────────────────────────────────────
# FREE_EXERCISES_PER_DAY=15
# FREE_AI_PER_DAY=3
# PRO_EXERCISES_PER_DAY=500   # uso justo: frena scripts y cuentas compartidas
# PRO_AI_PER_DAY=100
# PRO_PRICE_ARS=5000
# PRO_GRACE_DAYS=3            # días extra de Pro si el cobro mensual se demora
# USAGE_UTC_OFFSET_HOURS=-3   # los límites se reinician a la medianoche de Argentina

# ── Costo de la IA (USD por millón de tokens del modelo que uses) ────────────
# AI_PRICE_INPUT_PER_M=0.75
# AI_PRICE_OUTPUT_PER_M=3.75

# ── Mercado Pago (suscripciones) ─────────────────────────────────────────────
# Usá primero las credenciales de PRUEBA y usuarios de prueba.
# MP_ACCESS_TOKEN=APP_USR-...
# MP_WEBHOOK_SECRET=          # Tus integraciones > Webhooks > clave secreta
# FRONTEND_URL=https://mathvision.tudominio.com   # Mercado Pago vuelve acá después de pagar
